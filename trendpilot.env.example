# TrendPilot settings. Most people never edit this by hand: double-click
# TrendPilot (or run `trendpilot setup`) and the wizard writes it for you.
# Keep the real trendpilot.env private: it holds your keys.

# --- Keys (skip any you don't need) ----------------------------------------
DISCORD_BOT_TOKEN=
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# AI writer for /suggest: any OpenAI-compatible API.
# Groq: https://api.groq.com/openai/v1   OpenRouter: https://openrouter.ai/api/v1
# OpenAI: https://api.openai.com/v1      Ollama: http://localhost:11434/v1 (key: ollama)
TRENDPILOT_LLM_BASE_URL=
TRENDPILOT_LLM_MODEL=
TRENDPILOT_LLM_API_KEY=

# --- Where you are -----------------------------------------------------------
TRENDPILOT_REGION=US          # country for YouTube trends
TRENDPILOT_LANGUAGE=          # only count Twitch streams in this language, e.g. en
TRENDPILOT_TZ=                # e.g. America/New_York; empty = this computer's zone

# --- Your stream (optional) ---------------------------------------------------
TWITCH_CHANNEL=               # your channel: go-live posts, chat highlights, raids
OBS_WEBSOCKET_PASSWORD=       # OBS → Tools → WebSocket Server Settings
OBS_WEBSOCKET_ADDR=           # default localhost:4455

# --- Optional ------------------------------------------------------------------
DISCORD_GUILD_ID=             # your server ID: commands appear there instantly
TRENDPILOT_SCAN=10m           # how often Twitch/YouTube games are scanned (min 2m)
TRENDPILOT_GAMES_TOP=30       # how many top Twitch categories to scan
TRENDPILOT_SHIFT_WINDOW=20m   # trend alerts compare against this long ago
TRENDPILOT_POLL=5m            # how often /watch videos are checked (min 1m)
TRENDPILOT_MAX_CPUS=1         # CPU cores TrendPilot may use
TRENDPILOT_MAX_MEMORY_MB=150  # soft memory ceiling
TRENDPILOT_DATA_DIR=          # where viewer history is saved; "off" = memory only
TRENDPILOT_ADDR=127.0.0.1:8790  # local JSON API
TRENDPILOT_WEBHOOK=           # also POST every alert as JSON to this URL
